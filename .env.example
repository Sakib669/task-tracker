# ==============================================================================
# Environment Variables Example
# ==============================================================================

# --- [MANDATORY] ---
# Database connection for pooling (e.g., Supabase, Neon)
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"

# Direct database connection for running Prisma migrations
DIRECT_URL="postgresql://user:password@host:port/database"

# Authentication secret for NextAuth.js
AUTH_SECRET="generate-a-secure-random-key"

# The public URL of your application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- [REDIS] ---
# Full Redis connection string (for Render, Upstash, etc.)
REDIS_URL="rediss://default:your-token@your-redis-host:6379"

# OR if using Upstash REST (alternative)
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# --- [STRIPE] ---
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# --- [AI] ---
GROQ_API_KEY="your-groq-api-key"